<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="20dp">

    <!-- 顶部：日期和星期组合 (组合在同一个 TextClock 中，更简洁) -->
    <TextClock
        android:id="@+id/tc_date_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:format12Hour="MM月dd日 EEEE"
        android:format24Hour="MM月dd日 EEEE"
        android:textColor="#804A4A4A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 背景装饰：左引号 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="“"
        android:textSize="90sp"
        android:textColor="#0D000000"
        android:layout_alignTop="@id/tv_hitokoto"
        android:layout_alignParentStart="true"
        android:layout_marginTop="-45dp"
        android:layout_marginStart="5dp" />

    <!-- 中间：一句话内容 -->
    <TextView
        android:id="@+id/tv_hitokoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="加载中..."
        android:textSize="18sp"
        android:textColor="#4A4A4A"
        android:lineSpacingExtra="6dp"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:ellipsize="end"
        android:fontFamily="serif" />


    <!-- 底部右侧：作者 -->
    <TextView
        android:id="@+id/tv_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="4dp"
        android:text="—— 未知"
        android:textSize="12sp"
        android:textColor="#804A4A4A"
        android:fontFamily="serif"
        android:textStyle="italic" />

</RelativeLayout>